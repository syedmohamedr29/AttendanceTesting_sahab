  {
    "test_id": "TC-DOC-02",
    "category": "Doc ID",
    "title": "POST with explicit id: null in request body",
    "method": "post",
    "url": "https://attendance2.dev.zoolwork.com/api/companies/3a249870-184c-0373-f344-015d602678d7/attpolicies/break",
    "payload": {
      "id": null,
      "name": {
        "en": "Break ID Null"
      },
      "breaks": [
        {
          "name": "Coffee",
          "type": "Paid",
          "durationMinutes": 15
        }
      ]
    },
    "expected": "400 Bad Request (Cannot convert null to System.Guid)",
    "status": 400,
    "response": {
      "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
      "title": "One or more validation errors occurred.",
      "status": 400,
      "errors": {
        "request": [
          "The request field is required."
        ],
        "$.id": [
          "The JSON value could not be converted to System.Guid. Path: $.id | LineNumber: 0 | BytePositionInLine: 11."
        ]
      },
      "traceId": "00-0778dcd36aea726aac113264e157ad26-9fed704d6aedce07-00"
    }
  },
